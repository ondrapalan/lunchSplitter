generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  OPEN
  CLOSED
}

enum OrderType {
  NORMAL
  SEKACKA
}

enum OrderActivityAction {
  CREATED
  PUBLISHED_TO_DISCORD
  ITEM_ADDED
  ITEM_EDITED
  ITEM_REMOVED
  JOINED
  LEFT
  MANUAL_ADDED
  MANUAL_REMOVED
  PENDING_LINK_CREATED
  CLOSED
  REOPENED
}

enum ActivitySource {
  DISCORD
  WEB
  ADMIN
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

model User {
  id                   String               @id @default(cuid())
  username             String               @unique
  passwordHash         String
  displayName          String
  aliases              String[]             @default([])
  bankAccountNumber    String?
  discordId            String?              @unique
  role                 Role                 @default(USER)
  isFirstLogin         Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orders               Order[]
  orderPersons         OrderPerson[]
  invitationsSent      Invitation[]         @relation("InvitedByUser")
  invitationUsed       Invitation?          @relation("UsedByUser")
  guestsAsDefaultHost  Guest[]              @relation("GuestDefaultHost")
  orderPersonsHosted   OrderPerson[]        @relation("OrderPersonHost")
  activityActedOn      OrderActivityLog[]   @relation("ActivityActor")
  activityTargetedBy   OrderActivityLog[]   @relation("ActivityTargetUser")
  pendingLinksResolved PendingDiscordLink[] @relation("PendingLinkResolver")
}

model Guest {
  id                 String             @id @default(cuid())
  name               String
  aliases            String[]           @default([])
  defaultHostUserId  String
  defaultHost        User               @relation("GuestDefaultHost", fields: [defaultHostUserId], references: [id])
  orderPersons       OrderPerson[]
  activityTargetedBy OrderActivityLog[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([defaultHostUserId])
}

model Order {
  id                       String               @id @default(cuid())
  restaurant               Restaurant           @relation(fields: [restaurantId], references: [id])
  restaurantId             String
  globalDiscountPercent    Float                @default(0)
  bankAccountNumber        String?
  createdBy                User                 @relation(fields: [createdById], references: [id])
  createdById              String
  status                   OrderStatus          @default(OPEN)
  type                     OrderType            @default(NORMAL)
  discordAnnounceChannelId String?
  discordAnnounceMessageId String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  feeAdjustments           FeeAdjustment[]
  people                   OrderPerson[]
  activityLog              OrderActivityLog[]
  pendingLinks             PendingDiscordLink[]
}

model FeeAdjustment {
  id        String @id @default(cuid())
  name      String
  amount    Float
  sortOrder Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
}

model OrderPerson {
  id                  String               @id @default(cuid())
  name                String
  sortOrder           Int
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId             String
  user                User?                @relation(fields: [userId], references: [id])
  userId              String?
  guest               Guest?               @relation(fields: [guestId], references: [id])
  guestId             String?
  host                User?                @relation("OrderPersonHost", fields: [hostUserId], references: [id])
  hostUserId          String?
  items               OrderItem[]
  sharedItemLinks     SharedItemLink[]
  customShares        CustomShare[]
  paymentConfirmation PaymentConfirmation?

  @@index([guestId])
  @@index([hostUserId])
}

model PaymentConfirmation {
  id               String      @id @default(cuid())
  orderPerson      OrderPerson @relation(fields: [orderPersonId], references: [id], onDelete: Cascade)
  orderPersonId    String      @unique
  confirmedAt      DateTime    @default(now())
  confirmedVia     String      @default("discord")
  discordMessageId String?
}

model OrderItem {
  id              String           @id @default(cuid())
  name            String
  price           Float
  discountPercent Float?
  isPackaging     Boolean          @default(false)
  sortOrder       Int
  person          OrderPerson      @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId        String
  sharedWith      SharedItemLink[]
  customShares    CustomShare[]
}

model SharedItemLink {
  id       String      @id @default(cuid())
  item     OrderItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
  person   OrderPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String

  @@unique([itemId, personId])
}

model CustomShare {
  id       String      @id @default(cuid())
  item     OrderItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
  person   OrderPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  amount   Float

  @@unique([itemId, personId])
}

model AccessRequest {
  id               String   @id @default(cuid())
  username         String   @unique
  displayName      String
  passwordHash     String
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  discordMessageId String?
}

model Invitation {
  id          String    @id @default(cuid())
  token       String    @unique
  invitedBy   User      @relation("InvitedByUser", fields: [invitedById], references: [id])
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedBy      User?     @relation("UsedByUser", fields: [usedById], references: [id])
  usedById    String?   @unique
}

model OrderActivityLog {
  id            String              @id @default(cuid())
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  action        OrderActivityAction
  actorUserId   String?
  actor         User?               @relation("ActivityActor", fields: [actorUserId], references: [id])
  targetUserId  String?
  targetUser    User?               @relation("ActivityTargetUser", fields: [targetUserId], references: [id])
  targetGuestId String?
  targetGuest   Guest?              @relation(fields: [targetGuestId], references: [id])
  source        ActivitySource
  note          String?
  createdAt     DateTime            @default(now())

  @@index([orderId, createdAt])
}

model Housekeeping {
  id        String   @id @default(cuid())
  lastRunAt DateTime
}

model PendingDiscordLink {
  id                 String    @id @default(cuid())
  discordId          String    @unique
  discordUsername    String
  discordGlobalName  String?
  discordNick        String?
  triggeredByOrderId String?
  triggeredByOrder   Order?    @relation(fields: [triggeredByOrderId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolvedByUser     User?     @relation("PendingLinkResolver", fields: [resolvedByUserId], references: [id])
}
