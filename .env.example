# Sandbox Postgres runs in Docker on port 5433 — see docker-compose.yml.
# `npm run dev` starts it automatically and runs `prisma db push`.
DATABASE_URL=postgresql://lunchsplitter:lunchsplitter@localhost:5433/lunchsplitter
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3100

# Discord Bot (optional — enables QR code DMs, access-request approvals, Sekačka announcements)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Sekačka announcements are posted to this channel in #obědy (Discord snowflake ID)
DISCORD_OBEDY_CHANNEL_ID=

# Discord server (guild) ID — lets the admin Discord-linking page read the member
# list. Requires SERVER MEMBERS INTENT in the Developer Portal (Bot -> Privileged
# Gateway Intents); no server-admin action and no bot permission is involved.
# Not a secret. Left empty, the admin page reports which guilds the bot is in.
DISCORD_GUILD_ID=

# Belt-and-suspenders: set to 1 in .env.local to log Discord API payloads instead of sending them.
# Combine with leaving DISCORD_BOT_TOKEN blank for full safety during local dev.
DISCORD_DRY_RUN=

# Set to your own Discord user ID to redirect ALL outbound Discord traffic
# (DMs + Sekačka channel announcements + their edits) to a DM with you. Each
# message gets a [DEBUG] header identifying the original target. Requires
# DISCORD_DRY_RUN to be off and a real DISCORD_BOT_TOKEN. Use this for end-to-end
# Discord testing on localhost. Note: while enabled, the FIRST publish of a
# Sekačka writes the redirected DM channel ID into the DB, so subsequent edits
# stay in your DM even if you later disable debug mode for that order.
DISCORD_DEBUG_USER_ID=
