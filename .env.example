# Sandbox Postgres runs in Docker on port 5433 — see docker-compose.yml.
# `npm run dev` starts it automatically and runs `prisma db push`.
DATABASE_URL=postgresql://lunchsplitter:lunchsplitter@localhost:5433/lunchsplitter
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3100

# Discord Bot (optional — enables QR code DMs, access-request approvals, Sekačka announcements)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Sekačka announcements are posted to this channel in #obědy (Discord snowflake ID)
DISCORD_OBEDY_CHANNEL_ID=

# Belt-and-suspenders: set to 1 in .env.local to log Discord API payloads instead of sending them.
# Combine with leaving DISCORD_BOT_TOKEN blank for full safety during local dev.
DISCORD_DRY_RUN=
