{
  "name": "lunch-splitter",
  "private": true,
  "version": "1.0.0.20260427.1",
  "scripts": {
    "dev": "npm run sandbox:guard && npm run sandbox:up && dotenv -e .env.local -e .env -- npx prisma db push --skip-generate && dotenv -e .env.local -e .env -- npx prisma db seed && dotenv -e .env.local -e .env -- next dev -p 3100",
    "dev:clean": "npm run sandbox:guard && docker compose down -v && docker compose up -d --wait && dotenv -e .env.local -e .env -- npx prisma db push --skip-generate && dotenv -e .env.local -e .env -- npx tsx prisma/seed.dev.ts && dotenv -e .env.local -e .env -- next dev -p 3100",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox:guard": "node scripts/sandbox-guard.mjs",
    "sandbox:up": "docker compose up -d --wait",
    "sandbox:down": "docker compose down"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^28.1.0",
    "prisma": "^6.9.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.9.0",
    "@tanstack/react-query": "^5.80.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "discord-interactions": "^4.4.0",
    "next": "^15.3.4",
    "next-auth": "^5.0.0-beta.25",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-toastify": "^11.0.5",
    "styled-components": "^6.3.11",
    "zod": "^4.3.6"
  }
}
